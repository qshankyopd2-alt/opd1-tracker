# Normalize line endings; let Git decide text vs binary via auto-detection.
* text=auto

# Windows scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Shell scripts keep LF
*.sh text eol=lf

# Binaries — never diff/normalize
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.exe binary
*.dll binary
