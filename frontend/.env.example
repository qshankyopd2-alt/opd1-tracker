# Copy to .env.development (or .env) to enable local dev tools.
# The Design Mode harness only loads when VITE_DESIGN_MODE is "true" AND
# import.meta.env.DEV is true. Production builds never set this.
VITE_DESIGN_MODE=false

# Vite uses VITE_BACKEND_URL when not running inside the Tauri shell.
# Leave blank to use the Tauri-managed backend connection.
VITE_BACKEND_URL=
VITE_BACKEND_TOKEN=
