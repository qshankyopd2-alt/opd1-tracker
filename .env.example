# ─── OPD1 Tracker — environment ────────────────────────────────────────────
# Copy to "backend/.env" and fill in what you need. Every variable has a sane
# default and the app runs fully in demo mode with nothing set.
# The desktop app (Tauri) does not require this file at all.

# ─── Riot / data source ────────────────────────────────────────────────────

# Official Riot API key — https://developer.riotgames.com
# Optional. Used to reveal hidden names via account-v1. Never required.
RIOT_API_KEY=

# Shard: na | eu | ap | kr | latam | br (normally auto-detected)
RIOT_REGION=na

# Data source: auto | local | demo
#   auto   local client when VALORANT is running, else demo
#   local  require the local Riot client (error surfaced if it is not running)
#   demo   always serve deterministic generated data (source:"demo";
#          the UI refuses to render it as real — good for UI development)
DATA_SOURCE=auto

# Global Riot request rate limit (requests/second). Lower it if you share the
# machine with other Riot-API tools. 0 disables throttling (not recommended).
RIOT_MAX_RPS=10

# ─── Backend server ────────────────────────────────────────────────────────

# Standalone development port. The Tauri shell passes BACKEND_PORT=0 and picks
# a free loopback port automatically with a per-launch auth token.
BACKEND_PORT=5000

# Verbose Flask dev server (app.py standalone only; desktop.py ignores it).
FLASK_DEBUG=false

# Set to 1 to silence backend console logging.
SCOUT_QUIET=

# Set to false to skip live K/D + HS enrichment in the live scoreboard.
LIVE_INCLUDE_STATS=true

# Cache TTL (seconds) for player/profile lookups.
PLAYER_CACHE_TTL=60

# ─── Frontend (browser dev mode only) ──────────────────────────────────────
# In browser dev (option B of the README) point the UI at the Flask server.
# Leave both empty for `npm run dev` (Vite proxies /api to 127.0.0.1:5000).
VITE_BACKEND_URL=
VITE_BACKEND_TOKEN=

# ─── Set automatically by the Tauri shell — do not set manually ────────────
# OPD1_API_TOKEN    per-launch bearer token for the local API
# OPD1_APP_VERSION  app version shown in the UI
# OPD1_DATA_DIR     user data directory (AppData\com.opd1.tracker\data)
# OPD1_LOG_DIR      log directory        (AppData\com.opd1.tracker\logs)
# OPD1_PYTHON       Python executable used in dev when "python" is not on PATH
